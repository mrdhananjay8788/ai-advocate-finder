# Database Configuration
DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_SECRET="change-this-in-production-to-a-secure-secret-key"

# AI Service (Google Gemini)
GEMINI_API_KEY=""

# Email OTP Configuration (Gmail SMTP)
# 1. Enable 2-Step Verification in your Google Account.
# 2. Go to Google Account -> Security -> App passwords.
# 3. Generate a 16-character App Password (e.g. "abcd efgh ijkl mnop").
MAIL_HOST="smtp.gmail.com"
MAIL_PORT="587"
MAIL_USER="your-email@gmail.com"
MAIL_PASSWORD="your-16-char-gmail-app-password"
MAIL_FROM="\"LexisMatch AI\" <your-email@gmail.com>"

# Mobile SMS OTP Configuration (Indian SMS Gateways: MSG91 or 2Factor)
# Choose SMS_PROVIDER: "msg91" | "2factor" | "mock"
SMS_PROVIDER="msg91"
SMS_API_KEY="your-sms-gateway-api-key"
SMS_TEMPLATE_ID="your-dlt-approved-template-id"
SMS_SENDER_ID="LXMTCH"
