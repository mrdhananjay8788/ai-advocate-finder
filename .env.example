# Database Configuration
DATABASE_URL="file:./dev.db"

# Authentication
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRATION="1d"

# Frontend API URL
NEXT_PUBLIC_API_URL="http://localhost:3001"

# AI Service (Google Gemini)
GEMINI_API_KEY=""

# Email OTP Configuration (Gmail SMTP)
MAIL_HOST="smtp.gmail.com"
MAIL_PORT="587"
MAIL_USER="your-email@gmail.com"
MAIL_PASSWORD="your-16-char-gmail-app-password"
MAIL_FROM="\"LexisMatch AI\" <your-email@gmail.com>"

# Mobile SMS OTP Configuration (MSG91 / 2Factor)
SMS_PROVIDER="msg91"
SMS_API_KEY="your-sms-api-key"
SMS_TEMPLATE_ID="your-template-id"
SMS_SENDER_ID="LXMTCH"
